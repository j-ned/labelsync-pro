{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j-ned/labelsync-pro/.github/config/labels.schema.json",
  "title": "GitHub labels configuration",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": { "$ref": "#/$defs/Label" },
  "$defs": {
    "Label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "color"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$"
        },
        "description": {
          "type": "string",
          "maxLength": 100
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
