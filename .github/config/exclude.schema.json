{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j-ned/labelsync-pro/.github/config/exclude.schema.json",
  "title": "Repos exclusion list",
  "type": "object",
  "additionalProperties": false,
  "required": ["repos"],
  "properties": {
    "repos": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^/\\s]+/[^/\\s]+$"
      }
    }
  }
}
